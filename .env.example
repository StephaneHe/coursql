# coursSQL — environment for local Docker Compose (WSL).
# Copy to .env and adjust. These are DEV-ONLY secrets; change them for any real deployment.

# MySQL root (used by the container entrypoint + init scripts)
MYSQL_ROOT_PASSWORD=root_dev_pw

# Application accounts (must match db/init/02-accounts.sql)
APP_DB_PASSWORD=coursql_app_pw
EXEC_DB_PASSWORD=coursql_exec_pw
PROV_DB_PASSWORD=coursql_prov_pw

# API session signing secret (cookie signature). Change in production.
SESSION_SECRET=dev_session_secret_change_me

# Host port published by Docker (reach it via the private network: http://localhost:8080)
APP_HOST_PORT=8080
